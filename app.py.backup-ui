"""Streamlit UI for the Cyber Architecture Reviewer.

This file contains no review logic. It uploads a document, calls the review
pipeline, and renders the result. Everything it knows about reviewing comes
from src/. That separation is deliberate: the same pipeline runs from the CLI
and from CI with no UI code involved.
"""

from __future__ import annotations

import hashlib
import json
import sys
import time
from pathlib import Path

import streamlit as st

# Make project root importable
sys.path.insert(0, str(Path(__file__).parent))

from src.agent import ReviewAgent
from src.architecture_flow import (
    Component,
    ComponentType,
    Connection,
    enrich_flow_with_risks,
    extract_components_from_sections,
)
from src.config import load_config
from src.domains import DOMAIN_LABELS
from src.guardrail import assess_scope
from src.llm import check_ollama
from src.models import SEVERITIES
from src.parser import (
    SUPPORTED_SUFFIXES,
    parse_document,
    parse_text,
    summarise_sections,
)
from src.report import save_outputs
from src.retriever import KnowledgeBase
from src.rules import rules_summary


# ============================================================================
# Page configuration
# ============================================================================

st.set_page_config(
    page_title="Cyber Architecture Reviewer",
    page_icon="🛡️",
    layout="wide",
)


# ============================================================================
# Constants
# ============================================================================

SEV_COLOUR = {
    "CRITICAL": "#b3261e",
    "HIGH": "#c9741a",
    "MEDIUM": "#8a7a12",
    "LOW": "#4a6572",
}

RAG_COLOUR = {
    "RED": "#b3261e",
    "AMBER": "#c9741a",
    "GREEN": "#2e7d32",
}


# ============================================================================
# Cached resources
# ============================================================================

@st.cache_resource(show_spinner=False)
def get_config():
    return load_config()


@st.cache_resource(show_spinner=False)
def get_kb():
    return KnowledgeBase(get_config())


@st.cache_data(ttl=30, show_spinner=False)
def get_kb_status():
    try:
        return get_kb().status()
    except Exception as exc:  # noqa: BLE001
        return {
            "counts": {},
            "total": 0,
            "warnings": [str(exc)],
            "embedding_model": "unknown",
        }


@st.cache_data(ttl=30, show_spinner=False)
def get_ollama_status():
    return check_ollama(get_config())


# ============================================================================
# Session state
# ============================================================================

def initialise_session_state() -> None:
    """Initialise all Streamlit session state used by the application."""

    defaults = {
        "result": None,
        "checkpoint_approved": False,
        "checkpoint_signature": None,
        "input_signature": None,
        "show_arch_editor": False,
        "architecture_flow_obj": None,
    }

    for key, value in defaults.items():
        if key not in st.session_state:
            st.session_state[key] = value


# ============================================================================
# Input signatures
# ============================================================================

def make_file_signature(file_bytes: bytes) -> str:
    """Return a stable signature for an uploaded file."""

    return hashlib.sha256(file_bytes).hexdigest()


def make_text_signature(text: str, document_name: str) -> str:
    """Return a stable signature for pasted input."""

    payload = f"{document_name}\n{text}".encode("utf-8")
    return hashlib.sha256(payload).hexdigest()


def make_checkpoint_signature(
    input_signature: str,
    domains: list[str],
) -> str:
    """Create a signature for the exact document + domain review scope."""

    domain_string = "|".join(sorted(domains))
    payload = f"{input_signature}|{domain_string}".encode("utf-8")
    return hashlib.sha256(payload).hexdigest()


def reset_for_new_input(input_signature: str) -> None:
    """Reset state only when the actual input document/text changes."""

    if st.session_state.input_signature == input_signature:
        return

    st.session_state.input_signature = input_signature
    st.session_state.checkpoint_approved = False
    st.session_state.checkpoint_signature = None
    st.session_state.result = None
    st.session_state.architecture_flow_obj = None
    st.session_state.show_arch_editor = False


# ============================================================================
# Sidebar - system health
# ============================================================================

def render_sidebar() -> list[str]:
    cfg = get_config()

    st.sidebar.title("🛡️ Reviewer")
    st.sidebar.caption("Local-first architecture assurance")

    st.sidebar.subheader("Review domains")

    selected: list[str] = []

    for key in ("network", "application", "security", "cloud_data"):
        default = cfg.raw["domains"].get(key, True)

        if st.sidebar.checkbox(
            DOMAIN_LABELS[key],
            value=default,
            key=f"dom_{key}",
        ):
            selected.append(key)

    st.sidebar.divider()
    st.sidebar.subheader("System status")

    # ------------------------------------------------------------------
    # Ollama
    # ------------------------------------------------------------------

    ollama = get_ollama_status()

    if ollama["reachable"]:
        if ollama["missing_models"]:
            st.sidebar.error(
                "Ollama is running but these models are not pulled: "
                + ", ".join(ollama["missing_models"])
            )

            st.sidebar.code(
                "\n".join(
                    f"ollama pull {model}"
                    for model in ollama["missing_models"]
                ),
                language="bash",
            )
        else:
            st.sidebar.success(
                f"Ollama ready · {ollama['llm']}"
            )
    else:
        st.sidebar.error("Ollama unreachable")
        st.sidebar.caption(
            ollama.get("error", "")[:200]
        )
        st.sidebar.code(
            "ollama serve",
            language="bash",
        )

    # ------------------------------------------------------------------
    # Knowledge base
    # ------------------------------------------------------------------

    kb = get_kb_status()
    total = kb.get("total", 0)

    if total:
        st.sidebar.success(
            f"Knowledge base · {total} clauses"
        )
    else:
        st.sidebar.error(
            "Knowledge base is empty"
        )
        st.sidebar.code(
            "python scripts/seed_kb.py",
            language="bash",
        )

    with st.sidebar.expander("Clauses by domain"):
        for domain, count in kb.get("counts", {}).items():
            st.write(
                f"**{DOMAIN_LABELS.get(domain, domain)}** — {count}"
            )

        st.caption(
            f"Embedding model: `{kb.get('embedding_model')}`"
        )

    # ------------------------------------------------------------------
    # Deterministic rules
    # ------------------------------------------------------------------

    with st.sidebar.expander("Deterministic rules"):
        for domain, count in rules_summary().items():
            st.write(
                f"**{DOMAIN_LABELS.get(domain, domain)}** — {count} rules"
            )

        st.caption(
            "These run before the model and produce identical findings "
            "on every run."
        )

    for warning in kb.get("warnings", []):
        st.sidebar.warning(warning)

    st.sidebar.divider()

    st.sidebar.caption(
        "Read and flag only. This tool has no write access to any system "
        "and does not approve or reject designs."
    )

    return selected


# ============================================================================
# Checkpoint rendering
# ============================================================================

def render_checkpoint(
    sections: list,
    domains: list[str],
) -> None:
    """Display the human-in-the-loop checkpoint before Layer 2."""

    st.divider()

    st.subheader("🔍 Pre-Flight Checkpoint")

    st.caption(
        "Before proceeding to the AI review layer, here's a summary of "
        "what will be analyzed. Layer 1 has already run deterministic "
        "rules on all sections."
    )

    # ------------------------------------------------------------------
    # Layer 1 findings
    # ------------------------------------------------------------------

    agent = ReviewAgent(
        config=get_config(),
        kb=get_kb(),
    )

    layer1_findings, kb_counts = agent.get_layer1_findings(
        sections,
        domains,
    )

    # ------------------------------------------------------------------
    # Pre-flight metrics
    # ------------------------------------------------------------------

    col1, col2, col3, col4 = st.columns(
        [1.2, 1.2, 1.2, 1.2]
    )

    with col1:
        st.metric(
            "Total Sections",
            len(sections),
        )

    with col2:
        in_scope_count = len(
            [
                section
                for section in sections
                if section.domain in domains
            ]
        )

        st.metric(
            "In-Scope Sections",
            in_scope_count,
        )

    with col3:
        st.metric(
            "Layer 1 Findings",
            len(layer1_findings),
        )

    with col4:
        kb_total = sum(kb_counts.values())

        st.metric(
            "KB Clauses",
            kb_total,
        )

    # ------------------------------------------------------------------
    # Domain breakdown
    # ------------------------------------------------------------------

    with st.expander(
        "📊 Section Distribution by Domain",
        expanded=False,
    ):
        summary = summarise_sections(sections)

        if domains:
            cols = st.columns(len(domains))

            for col, domain in zip(
                cols,
                sorted(domains),
            ):
                count = summary.get(domain, 0)

                col.markdown(
                    f"**{DOMAIN_LABELS.get(domain, domain)}**  \n"
                    f"{count} sections"
                )

    # ------------------------------------------------------------------
    # Layer 1 findings
    # ------------------------------------------------------------------

    if layer1_findings:
        with st.expander(
            "🚩 Layer 1 Findings (Deterministic Rules)",
            expanded=True,
        ):
            st.caption(
                f"{len(layer1_findings)} findings from "
                "deterministic pattern matching"
            )

            for finding in layer1_findings:
                sev_color = SEV_COLOUR.get(
                    finding.severity,
                    "#555",
                )

                st.markdown(
                    f"<div style='padding:8px 12px;"
                    f"border-left:3px solid {sev_color};"
                    f"margin-bottom:8px;'>"
                    f"<b>{finding.severity}</b> · "
                    f"{finding.section[:50]}  \n"
                    f"{finding.issue[:100]}"
                    f"</div>",
                    unsafe_allow_html=True,
                )
    else:
        st.success(
            "✓ No findings from deterministic rules",
            icon="✓",
        )

    # ------------------------------------------------------------------
    # Pipeline visualization
    # ------------------------------------------------------------------

    st.write("")
    st.write("**Pipeline Overview**")

    st.caption(
        "Light blue steps are already complete (deterministic). "
        "Amber steps will run in the AI review layer."
    )

    col1, col2 = st.columns([2, 3])

    with col1:
        st.markdown(
            """
            **Completed (Layer 1)**

            - 📄 Document parsing
            - 🏷️ Section classification
            - ⚙️ Deterministic rules

            **Trust Boundary** ← *You are here*

            **Proceeding to (Layer 2)**

            - 🗂️ KB retrieval
            - 🤖 AI reasoning
            - 🔗 Citation verification
            - 📊 Cross-domain pass
            - 📋 Report generation
            """
        )

    with col2:
        st.info(
            "**What happens next:**\n\n"
            "Once approved, the AI layer will:\n\n"
            "1. Retrieve relevant standards from the knowledge base\n"
            "2. Reason about each section using language models\n"
            "3. Verify citations against retrieved standards\n"
            "4. Perform cross-domain consistency checks\n"
            "5. Generate a detailed report with risk scoring\n\n"
            "All processing happens locally on this machine."
        )


# ============================================================================
# Architecture Flow
# ============================================================================

def get_architecture_flow(
    sections: list,
    findings: list,
):
    """
    Get a persistent ArchitectureFlow object.

    Streamlit reruns the script after every interaction. Keeping the
    ArchitectureFlow object in session_state prevents editor changes from
    disappearing after a button click.
    """

    if st.session_state.architecture_flow_obj is None:
        flow = extract_components_from_sections(sections)
        flow = enrich_flow_with_risks(
            flow,
            findings,
        )

        st.session_state.architecture_flow_obj = flow

    return st.session_state.architecture_flow_obj


def render_architecture_flow(
    sections: list,
    findings: list,
) -> None:
    """Display the Architecture Flow diagram with interactive editor."""

    st.caption(
        "Interactive data flow diagram extracted from your architecture. "
        "Click 'Full Editor' to add/edit components and connections."
    )

    # ------------------------------------------------------------------
    # Persistent flow
    # ------------------------------------------------------------------

    flow = get_architecture_flow(
        sections,
        findings,
    )

    # ------------------------------------------------------------------
    # Display summary
    # ------------------------------------------------------------------

    col1, col2, col3, col4 = st.columns(4)

    with col1:
        st.metric(
            "Components",
            len(flow.components),
        )

    with col2:
        st.metric(
            "Connections",
            len(flow.connections),
        )

    with col3:
        critical = sum(
            1
            for component in flow.components.values()
            if component.risk_level == "critical"
        )

        st.metric(
            "Critical",
            critical,
        )

    with col4:
        high = sum(
            1
            for component in flow.components.values()
            if component.risk_level == "high"
        )

        st.metric(
            "High Risk",
            high,
        )

    # ------------------------------------------------------------------
    # Components
    # ------------------------------------------------------------------

    if flow.components:
        with st.expander(
            "📊 Architecture Components",
            expanded=True,
        ):
            cols = st.columns(3)

            for idx, (comp_id, component) in enumerate(
                flow.components.items()
            ):
                with cols[idx % 3]:
                    risk_colors = {
                        "critical": "🔴",
                        "high": "🟠",
                        "medium": "🟡",
                        "low": "🟢",
                    }

                    st.markdown(
                        f"**{risk_colors.get(component.risk_level, '⚪')} "
                        f"{component.name}**  \n"
                        f"*{component.component_type.value}*  \n"
                        f"{component.description}"
                    )
    else:
        st.info(
            "No components detected. Use the full editor "
            "to add them manually."
        )

    # ------------------------------------------------------------------
    # Full editor button
    # ------------------------------------------------------------------

    st.write("")

    col1, col2 = st.columns([3, 1])

    with col2:
        if st.button(
            "📐 Full Editor",
            key="arch_editor",
        ):
            st.session_state.show_arch_editor = True
            st.rerun()

    # ------------------------------------------------------------------
    # Editor
    # ------------------------------------------------------------------

    if st.session_state.get(
        "show_arch_editor",
        False,
    ):
        st.divider()

        st.subheader(
            "Architecture Flow - Interactive Editor"
        )

        st.caption(
            "Add components, create connections, and modify the "
            "architecture model. Changes persist across Streamlit reruns."
        )

        editor_col1, editor_col2 = st.columns(
            [0.3, 1],
            gap="small",
        )

        # ==============================================================
        # LEFT SIDE
        # ==============================================================

        with editor_col1:
            st.markdown("**Add Component**")

            comp_type = st.selectbox(
                "Type",
                [
                    "service",
                    "database",
                    "cache",
                    "queue",
                    "api_gateway",
                    "external",
                    "storage",
                    "user",
                ],
                key="comp_type_select",
            )

            comp_name = st.text_input(
                "Name",
                key="comp_name_input",
            )

            comp_desc = st.text_area(
                "Description",
                key="comp_desc_input",
                height=100,
            )

            if st.button(
                "➕ Add",
                key="add_comp_btn",
            ):
                if not comp_name.strip():
                    st.warning(
                        "Enter a component name."
                    )
                else:
                    comp_id = (
                        f"{comp_type}_"
                        f"{len(flow.components) + 1}"
                    )

                    new_comp = Component(
                        id=comp_id,
                        name=comp_name.strip(),
                        component_type=ComponentType(comp_type),
                        description=comp_desc.strip(),
                    )

                    flow.add_component(new_comp)

                    st.success(
                        f"Added {comp_name.strip()}"
                    )

                    st.rerun()

            st.divider()

            st.markdown(
                "**Components in Diagram**"
            )

            if not flow.components:
                st.caption(
                    "No components."
                )

            for comp_id, comp in list(
                flow.components.items()
            ):
                col1, col2 = st.columns(
                    [3, 1]
                )

                with col1:
                    st.caption(
                        f"📦 {comp.name} "
                        f"({comp.component_type.value})"
                    )

                with col2:
                    if st.button(
                        "🗑️",
                        key=f"del_{comp_id}",
                    ):
                        flow.remove_component(
                            comp_id
                        )

                        st.rerun()

        # ==============================================================
        # RIGHT SIDE
        # ==============================================================

        with editor_col2:
            st.markdown("**Data Flows**")

            if flow.connections:
                for idx, conn in enumerate(
                    list(flow.connections)
                ):
                    src = flow.components.get(
                        conn.source_id
                    )

                    tgt = flow.components.get(
                        conn.target_id
                    )

                    if src and tgt:
                        col1, col2 = st.columns(
                            [3, 1]
                        )

                        with col1:
                            st.caption(
                                f"🔗 {src.name} → "
                                f"{tgt.name}"
                            )

                        with col2:
                            if st.button(
                                "🗑️",
                                key=f"del_conn_{idx}",
                            ):
                                flow.connections.pop(
                                    idx
                                )

                                st.rerun()
            else:
                st.info(
                    "No connections yet. "
                    "Add components first."
                )

            # ----------------------------------------------------------
            # Add connection
            # ----------------------------------------------------------

            st.markdown(
                "**Create Connection**"
            )

            source_options = {
                component.name: component_id
                for component_id, component
                in flow.components.items()
            }

            target_options = {
                component.name: component_id
                for component_id, component
                in flow.components.items()
            }

            if (
                source_options
                and target_options
            ):
                source_name = st.selectbox(
                    "From",
                    list(source_options.keys()),
                    key="conn_source",
                )

                target_name = st.selectbox(
                    "To",
                    list(target_options.keys()),
                    key="conn_target",
                )

                if st.button(
                    "➕ Connect",
                    key="add_conn_btn",
                ):
                    if source_name != target_name:
                        conn = Connection(
                            source_id=source_options[
                                source_name
                            ],
                            target_id=target_options[
                                target_name
                            ],
                            label="data flow",
                        )

                        flow.add_connection(conn)

                        st.success(
                            f"Connected "
                            f"{source_name} → "
                            f"{target_name}"
                        )

                        st.rerun()
                    else:
                        st.warning(
                            "Source and target "
                            "must be different."
                        )

        # --------------------------------------------------------------
        # Save architecture
        # --------------------------------------------------------------

        st.divider()

        col1, col2 = st.columns(
            [1, 1]
        )

        with col1:
            if st.button(
                "💾 Save Architecture",
                key="save_arch_btn",
                type="primary",
            ):
                st.session_state.architecture_flow = (
                    flow.to_dict()
                )

                st.success(
                    "Architecture saved!"
                )

        with col2:
            if st.button(
                "✕ Close Editor",
                key="close_arch_editor",
            ):
                st.session_state.show_arch_editor = False
                st.rerun()


# ============================================================================
# Result rendering
# ============================================================================

def render_result(result) -> None:
    """Render completed review result."""

    counts = result.counts_by_severity()

    # ------------------------------------------------------------------
    # Summary
    # ------------------------------------------------------------------

    c1, c2, c3, c4 = st.columns(
        [1.4, 1, 1, 1]
    )

    with c1:
        colour = RAG_COLOUR.get(
            result.rag_status,
            "#555",
        )

        st.markdown(
            f"<div style='padding:14px 18px;"
            f"border-radius:10px;"
            f"background:{colour};color:white;'>"
            f"<div style='font-size:12px;opacity:.85;"
            f"letter-spacing:.08em;'>"
            f"ASSURANCE STATUS</div>"
            f"<div style='font-size:30px;"
            f"font-weight:700;line-height:1.2;'>"
            f"{result.rag_status}</div>"
            f"<div style='font-size:12px;opacity:.9;'>"
            f"risk score {result.risk_score}/100"
            f"</div></div>",
            unsafe_allow_html=True,
        )

    with c2:
        st.metric(
            "Findings",
            len(result.findings),
        )

    with c3:
        st.metric(
            "Critical",
            counts.get("CRITICAL", 0),
        )

    with c4:
        st.metric(
            "Sections analysed",
            len(result.sections),
        )

    st.write("")

    # ------------------------------------------------------------------
    # Severity summary
    # ------------------------------------------------------------------

    sev_cols = st.columns(4)

    for col, sev in zip(
        sev_cols,
        SEVERITIES,
    ):
        col.markdown(
            f"<div style='border-left:4px solid "
            f"{SEV_COLOUR[sev]};padding:6px 12px;'>"
            f"<b>{counts.get(sev, 0)}</b> "
            f"<span style='font-size:12px;"
            f"color:#666;'>{sev}</span>"
            f"</div>",
            unsafe_allow_html=True,
        )

    # ------------------------------------------------------------------
    # Warnings
    # ------------------------------------------------------------------

    for warning in result.warnings:
        st.warning(warning)

    # ------------------------------------------------------------------
    # Tabs
    # ------------------------------------------------------------------

    tabs = st.tabs(
        [
            "Report",
            "Findings",
            "Architecture Flow",
            "Audit trail",
            "Section map",
            "Export",
        ]
    )

    # ==============================================================
    # Report
    # ==============================================================

    with tabs[0]:
        st.markdown(
            result.report_markdown
        )

    # ==============================================================
    # Findings
    # ==============================================================

    with tabs[1]:
        if not result.findings:
            st.info(
                "No findings were raised."
            )

        else:
            sev_filter = st.multiselect(
                "Severity",
                SEVERITIES,
                default=list(SEVERITIES),
            )

            available_domains = sorted(
                {
                    finding.domain
                    for finding in result.findings
                }
            )

            dom_filter = st.multiselect(
                "Domain",
                available_domains,
                default=available_domains,
                format_func=lambda domain:
                    DOMAIN_LABELS.get(
                        domain,
                        domain,
                    ),
            )

            only_grounded = st.checkbox(
                "Only findings cited to a knowledge base clause",
                value=False,
            )

            shown = [
                finding
                for finding in result.findings
                if (
                    finding.severity in sev_filter
                    and finding.domain in dom_filter
                    and (
                        finding.is_grounded
                        or not only_grounded
                    )
                )
            ]

            st.caption(
                f"{len(shown)} of "
                f"{len(result.findings)} findings"
            )

            for finding in shown:
                label = (
                    f"{finding.severity} · "
                    f"{finding.section[:60]} · "
                    f"{finding.issue[:90]}"
                )

                with st.expander(label):
                    st.markdown(
                        f"**Issue.** "
                        f"{finding.issue}"
                    )

                    st.markdown(
                        f"**Recommendation.** "
                        f"{finding.recommendation}"
                    )

                    if finding.standard_reference:
                        st.markdown(
                            f"**Standard.** "
                            f"{finding.standard_reference}"
                            + (
                                f" — `{finding.kb_source}`"
                                if finding.kb_source
                                else ""
                            )
                        )
                    else:
                        st.caption(
                            "No knowledge base clause cited — "
                            "this reflects general practice, "
                            "not your organisation's standard."
                        )

                    if finding.evidence_excerpt:
                        st.markdown(
                            "**Evidence from the design**"
                        )

                        st.code(
                            finding.evidence_excerpt,
                            language=None,
                        )

                    if finding.control_mappings:
                        st.markdown(
                            "**Controls.** "
                            + ", ".join(
                                finding.control_mappings
                            )
                        )

                    st.caption(
                        f"Provenance: "
                        f"{finding.origin}"
                        + (
                            f" ({finding.rule_id})"
                            if finding.rule_id
                            else ""
                        )
                        + f" · confidence "
                        f"{finding.confidence}"
                        f" · id "
                        f"{finding.fingerprint}"
                    )

    # ==============================================================
    # Architecture Flow
    # ==============================================================

    with tabs[2]:
        render_architecture_flow(
            result.sections,
            result.findings,
        )

    # ==============================================================
    # Audit trail
    # ==============================================================

    with tabs[3]:
        st.caption(
            "Every retrieval, tool call and model decision in this run. "
            "If a finding cannot be explained from this trail, it should "
            "not be acted on."
        )

        from src.audit import AuditTrail

        trail = AuditTrail()

        trail.extend(
            result.audit
        )

        st.markdown(
            trail.render_markdown(
                limit=300
            )
        )

    # ==============================================================
    # Section map
    # ==============================================================

    with tabs[4]:
        st.caption(
            "How each section of your document was classified. "
            "Low confidence means the classifier was unsure which "
            "lens to apply — check those sections manually."
        )

        rows = [
            {
                "Section": section.heading,
                "Domain": DOMAIN_LABELS.get(
                    section.domain,
                    section.domain,
                ),
                "Topic": section.topic,
                "Confidence": section.topic_confidence,
                "Words": section.word_count,
            }
            for section in result.sections
        ]

        st.dataframe(
            rows,
            use_container_width=True,
            hide_index=True,
        )

    # ==============================================================
    # Export
    # ==============================================================

    with tabs[5]:
        paths = save_outputs(
            result,
            get_config(),
        )

        st.success(
            f"Saved to `{paths['report'].parent}`"
        )

        st.download_button(
            "Download report (Markdown)",
            data=result.report_markdown,
            file_name=paths["report"].name,
            mime="text/markdown",
        )

        st.download_button(
            "Download audit bundle (JSON)",
            data=json.dumps(
                result.to_dict(),
                indent=2,
                default=str,
            ),
            file_name=paths["audit"].name,
            mime="application/json",
        )

        st.caption(
            "The audit bundle contains every finding, every section, "
            "and the full reasoning trail. Retain it with the design "
            "authority record."
        )


# ============================================================================
# Main
# ============================================================================

def main() -> None:
    initialise_session_state()

    domains = render_sidebar()

    st.title(
        "Cyber Architecture Reviewer"
    )

    st.caption(
        "End-to-end design assurance across network, application, "
        "security and cloud architecture. Findings cite your standards, "
        "not generic guidance."
    )

    # ------------------------------------------------------------------
    # Input mode
    # ------------------------------------------------------------------

    mode = st.radio(
        "Input",
        [
            "Upload a document",
            "Paste text",
        ],
        horizontal=True,
        label_visibility="collapsed",
    )

    document_name = ""
    sections: list = []

    # ==================================================================
    # Upload
    # ==================================================================

    if mode == "Upload a document":
        uploaded = st.file_uploader(
            "HLD, LLD, application design, OpenAPI/IaC spec, "
            "or a draw.io/Visio topology diagram",
            type=[
                suffix.lstrip(".")
                for suffix in sorted(
                    SUPPORTED_SUFFIXES
                )
            ],
        )

        if uploaded:
            # IMPORTANT:
            # Do NOT reset checkpoint_approved on every rerun.
            #
            # Streamlit reruns the whole script after a button click.
            # The file remains uploaded, so resetting here would destroy
            # the approval immediately after clicking the button.
            file_bytes = uploaded.getvalue()

            input_signature = make_file_signature(
                file_bytes
            )

            reset_for_new_input(
                input_signature
            )

            tmp_dir = Path(
                "data/uploads"
            )

            tmp_dir.mkdir(
                parents=True,
                exist_ok=True,
            )

            tmp = tmp_dir / uploaded.name

            try:
                tmp.write_bytes(
                    file_bytes
                )

                # parse_document preserves topology graph information.
                sections = parse_document(
                    tmp
                )

                document_name = uploaded.name

            except Exception as exc:  # noqa: BLE001
                st.error(
                    f"Could not read that file: {exc}"
                )

    # ==================================================================
    # Paste text
    # ==================================================================

    else:
        text = st.text_area(
            "Paste the design content",
            height=280,
        )

        document_name = st.text_input(
            "Document name",
            value="pasted-design",
        )

        if text:
            input_signature = make_text_signature(
                text,
                document_name or "design",
            )

            reset_for_new_input(
                input_signature
            )

            sections = parse_text(
                text,
                document_name or "design",
            )

    # ------------------------------------------------------------------
    # Initial state
    # ------------------------------------------------------------------

    scope_ok = True
    force_review = False

    # ------------------------------------------------------------------
    # Process parsed sections
    # ------------------------------------------------------------------

    if sections:
        summary = summarise_sections(
            sections
        )

        st.info(
            f"Parsed **{len(sections)} sections** — "
            + " · ".join(
                f"{DOMAIN_LABELS.get(domain, domain)}: {count}"
                for domain, count
                in sorted(summary.items())
            )
        )

        # ==============================================================
        # Guardrail
        # ==============================================================

        scope = assess_scope(
            sections
        )

        if not scope.in_scope:
            scope_ok = False

            st.error(
                f"**Not an architecture design document.** "
                f"{scope.reason}"
            )

            st.caption(
                scope.suggestion
            )

            force_review = st.checkbox(
                "I've reviewed the message above and want "
                "to review this input anyway"
            )

        # ==============================================================
        # Checkpoint
        # ==============================================================

        if scope_ok or force_review:

            # The approval is tied to:
            #
            # 1. The exact document/text
            # 2. The selected review domains
            #
            # This prevents an approval for one review scope from being
            # reused after the user changes the domain selection.

            current_checkpoint_signature = (
                make_checkpoint_signature(
                    st.session_state.input_signature,
                    domains,
                )
            )

            checkpoint_approved = (
                st.session_state.checkpoint_approved
                and
                st.session_state.checkpoint_signature
                == current_checkpoint_signature
            )

            if not checkpoint_approved:
                # If domain selection changed, the previous approval
                # is no longer valid.
                st.session_state.checkpoint_approved = False
                st.session_state.checkpoint_signature = None

                render_checkpoint(
                    sections,
                    domains,
                )

                if st.button(
                    "Approve & Proceed to AI Review",
                    type="primary",
                    key="checkpoint_approve",
                ):
                    st.session_state.checkpoint_approved = True

                    st.session_state.checkpoint_signature = (
                        current_checkpoint_signature
                    )

                    # Explicit rerun is okay here because the approval
                    # is now persisted in session_state and will NOT be
                    # reset on the next rerun.
                    st.rerun()

            else:
                # ------------------------------------------------------
                # Approved state
                # ------------------------------------------------------

                with st.expander(
                    "✓ Checkpoint Approved",
                    expanded=False,
                ):
                    st.success(
                        "You have approved this document "
                        "for AI review."
                    )

                    st.caption(
                        f"{len(sections)} sections ready "
                        "for Layer 2 analysis"
                    )

                    if st.button(
                        "Review Checkpoint Again",
                        key="reopen_checkpoint",
                    ):
                        st.session_state.checkpoint_approved = False
                        st.session_state.checkpoint_signature = None
                        st.rerun()

                # Visible pipeline status
                st.success(
                    "✅ Trust boundary passed — "
                    "Layer 2 AI review is ready."
                )

    # ------------------------------------------------------------------
    # Run review state
    # ------------------------------------------------------------------

    current_checkpoint_signature = None

    if (
        sections
        and st.session_state.input_signature
        and domains
    ):
        current_checkpoint_signature = (
            make_checkpoint_signature(
                st.session_state.input_signature,
                domains,
            )
        )

    checkpoint_approved = (
        st.session_state.checkpoint_approved
        and
        st.session_state.checkpoint_signature
        == current_checkpoint_signature
    )

    disabled = (
        not sections
        or not domains
        or (
            not scope_ok
            and not force_review
        )
        or not checkpoint_approved
    )

    if not domains:
        st.warning(
            "Select at least one review domain in the sidebar."
        )

    # ------------------------------------------------------------------
    # Run review
    # ------------------------------------------------------------------

    if st.button(
        "Run review",
        type="primary",
        disabled=disabled,
        key="run_review",
    ):
        # --------------------------------------------------------------
        # Ollama health check
        # --------------------------------------------------------------

        ollama = get_ollama_status()

        if not ollama["reachable"]:
            st.error(
                "Ollama is not reachable. Start it with "
                "`ollama serve` and reload this page."
            )
            return

        if ollama["missing_models"]:
            st.error(
                "Pull the required models first: "
                + ", ".join(
                    ollama["missing_models"]
                )
            )
            return

        # --------------------------------------------------------------
        # Clear previous result
        # --------------------------------------------------------------

        st.session_state.result = None

        # --------------------------------------------------------------
        # Progress
        # --------------------------------------------------------------

        progress = st.progress(
            0.0,
            text="Starting",
        )

        started = time.time()

        # --------------------------------------------------------------
        # Agent
        # --------------------------------------------------------------

        agent = ReviewAgent(
            config=get_config(),
            kb=get_kb(),
        )

        agent.progress = (
            lambda stage, pct: progress.progress(
                pct,
                text=(
                    f"{stage} — "
                    f"{int(time.time() - started)}s"
                ),
            )
        )

        # --------------------------------------------------------------
        # Execute Layer 2
        # --------------------------------------------------------------

        try:
            st.session_state.result = agent.review(
                sections,
                document_name or "design",
                domains,
            )

            # New result means architecture flow needs to be rebuilt
            # from the new review.
            st.session_state.architecture_flow_obj = None
            st.session_state.show_arch_editor = False

        except Exception as exc:  # noqa: BLE001
            st.error(
                f"Review failed: {exc}"
            )

            st.exception(exc)

            return

        finally:
            progress.empty()

    # ------------------------------------------------------------------
    # Render result
    # ------------------------------------------------------------------

    if st.session_state.result:
        st.divider()

        render_result(
            st.session_state.result
        )


# ============================================================================
# Entry point
# ============================================================================

if __name__ == "__main__":
    main()