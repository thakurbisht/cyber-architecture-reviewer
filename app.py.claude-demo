"""
Complete Streamlit App with CSS Theme + Report Components Integration
Fixed layout with proper spacing
"""

import streamlit as st
from pathlib import Path
import json

# Import the report components
from src.components import (
    severity_bar, risk_gauge, rag_badge, counters, domain_rows,
    clause, evidence, controls, stage
)

# ============================================================================
# PAGE CONFIG & ASSETS
# ============================================================================

st.set_page_config(
    page_title="Architecture Review",
    page_icon="🛡️",
    layout="wide",
    initial_sidebar_state="expanded"
)

# Load the theme CSS - existing theme.css (if it exists)
assets_dir = Path(__file__).parent / "assets"
if (assets_dir / "theme.css").exists():
    with open(assets_dir / "theme.css") as f:
        theme_css = f.read()
    st.markdown(f"<style>{theme_css}</style>", unsafe_allow_html=True)

# Load refine.css - the new CSS refinement layer
if (assets_dir / "refine.css").exists():
    with open(assets_dir / "refine.css") as f:
        refine_css = f.read()
    st.markdown(f"<style>{refine_css}</style>", unsafe_allow_html=True)
else:
    st.warning("refine.css not found in assets/ folder")

# Add custom spacing fixes
st.markdown("""
<style>
.stColumn > div:first-child {
    padding-right: 20px;
}
.stColumn > div:last-child {
    padding-left: 20px;
}
</style>
""", unsafe_allow_html=True)

# ============================================================================
# EXAMPLE: DASHBOARD WITH ALL COMPONENTS
# ============================================================================

def render_example_dashboard():
    """Shows how to use all the report components."""

    # Sample data - this would come from your review analysis
    sample_findings = {
        "CRITICAL": 3,
        "HIGH": 8,
        "MEDIUM": 12,
        "LOW": 5
    }

    sample_domains = {
        "Network": {"CRITICAL": 1, "HIGH": 2, "MEDIUM": 3, "LOW": 1},
        "Application": {"CRITICAL": 2, "HIGH": 3, "MEDIUM": 4, "LOW": 2},
        "Data": {"CRITICAL": 0, "HIGH": 2, "MEDIUM": 3, "LOW": 1},
        "Identity": {"CRITICAL": 0, "HIGH": 1, "MEDIUM": 2, "LOW": 1},
    }

    sample_controls = ["NIST AC-2", "ISO 27001 A.9.2", "CIS 5.1"]

    # === HEADER STAGE ===
    header_content = """
    <h1 style="margin:0 0 8px;color:var(--car-ink)">Architecture Security Review</h1>
    <p style="margin:0;color:var(--car-ink-2);font-size:.95rem">
        System design assessment against compliance frameworks
    </p>
    """
    st.markdown(stage(header_content), unsafe_allow_html=True)

    st.markdown("")  # Add spacing

    # === SUMMARY ROW ===
    col1, col2, col3 = st.columns([2.5, 2.5, 1.5], gap="large")

    with col1:
        st.markdown("**Finding Distribution**")
        # Severity bar - shows distribution of findings by severity
        st.markdown(
            severity_bar(sample_findings),
            unsafe_allow_html=True
        )

    with col2:
        st.markdown("**Risk by Domain**")
        # Domain rows - shows where the risk lives
        st.markdown(
            domain_rows(sample_domains),
            unsafe_allow_html=True
        )

    with col3:
        st.markdown("**Overall Risk**")
        # Risk gauge - the one number that decides if design ships
        # Score range: 0-100, RAG: RED/AMBER/GREEN
        st.markdown(
            risk_gauge(score=67.5, rag="AMBER", size=168),
            unsafe_allow_html=True
        )

    st.divider()

    # === FINDINGS ===
    st.markdown("## Detailed Findings")

    st.markdown("")  # Add spacing

    # Counter row - headline figures
    headline_items = [
        (28, "Total Findings"),
        (3, "Critical"),
        (8, "High"),
        (12, "Medium"),
    ]
    st.markdown(counters(headline_items), unsafe_allow_html=True)

    st.markdown("")  # Add spacing

    # === FINDING CARDS ===
    st.markdown("### Issues Found")

    with st.expander("🔴 CRITICAL - Database encryption disabled", expanded=True):
        col1, col2 = st.columns([3, 1], gap="medium")
        with col1:
            st.markdown("**Issue**: Database backups are not encrypted in transit or at rest.")
            st.markdown("")
            st.markdown(evidence("SELECT * FROM backups WHERE region='us-west' AND encrypted=0"))
        with col2:
            st.markdown("")
            st.markdown("")
            st.markdown(clause("ISO 27001 A.10.2"))

    with st.expander("🟠 HIGH - API authentication weak"):
        col1, col2 = st.columns([3, 1], gap="medium")
        with col1:
            st.markdown("**Issue**: API endpoints accept basic auth over HTTP in staging.")
            st.markdown("")
            st.markdown(evidence("curl http://staging.api.example.com/v1/users -u admin:pass123"))
        with col2:
            st.markdown("")
            st.markdown("")
            st.markdown(clause("NIST AC-2"))

    with st.expander("🟡 MEDIUM - Audit logging incomplete"):
        col1, col2 = st.columns([3, 1], gap="medium")
        with col1:
            st.markdown("**Issue**: Administrative actions not logged for compliance review.")
            st.markdown("")
            st.markdown(evidence("Log configuration missing: admin_action_log = disabled"))
        with col2:
            st.markdown("")
            st.markdown("")
            st.markdown(clause("CIS 5.2"))

    st.divider()

    # === CONTROL MAPPINGS ===
    st.markdown("### Applicable Control Frameworks")
    st.markdown(controls(sample_controls), unsafe_allow_html=True)

    st.markdown("")  # Add spacing

    # === RAG BADGE ===
    st.markdown("### Recommendation")
    st.markdown(rag_badge("AMBER"), unsafe_allow_html=True)
    st.markdown("")
    st.write("**Approve with conditions**: Resolve critical database encryption issue and high API authentication gap before production deployment.")


# ============================================================================
# MAIN APP
# ============================================================================

def main():
    # Sidebar - minimal UI
    with st.sidebar:
        st.markdown("### Menu")
        page = st.radio(
            "Select page:",
            ["Dashboard", "Upload Review", "Settings"],
            label_visibility="collapsed"
        )

    if page == "Dashboard":
        render_example_dashboard()

    elif page == "Upload Review":
        st.markdown("## Upload Architecture Review")
        st.write("Upload your review data (JSON format)")
        uploaded = st.file_uploader("Choose file", type=["json"])
        if uploaded:
            try:
                data = json.load(uploaded)
                st.success("File loaded successfully")
                st.json(data)
            except Exception as e:
                st.error(f"Error: {e}")

    elif page == "Settings":
        st.markdown("## Settings")
        st.write("Theme and display preferences")
        dark_mode = st.toggle("Dark mode", value=True)
        st.info(f"Dark mode: {dark_mode}")


if __name__ == "__main__":
    main()